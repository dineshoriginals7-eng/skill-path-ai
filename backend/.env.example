# SkillPath AI — Backend Environment Configuration
# Copy this file to .env and fill in your values

# --- Application ---
APP_NAME="SkillPath AI"
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# SQLite (local dev) — no credentials needed
DATABASE_URL=sqlite:///./skillpath.db

# Supabase (production) — uncomment and fill in
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# --- File Storage ---
# Local storage (dev)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Supabase Storage (production) — uncomment and fill in
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI Provider ---
# Set DEMO_MODE=true to use realistic mock data without any API key
DEMO_MODE=true

# Google Gemini (recommended free tier)
GEMINI_API_KEY=your-gemini-api-key

# OpenAI (alternative)
# OPENAI_API_KEY=your-openai-api-key

# Default LLM provider: gemini | openai | demo
LLM_PROVIDER=demo

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Admin ---
ADMIN_EMAIL=admin@skillpath.ai
ADMIN_PASSWORD=AdminPass@123
